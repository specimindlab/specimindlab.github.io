# Dependencies
node_modules/

# Finished videos never enter git history: GitHub Releases hold them.
*.zip
# posting/<batch>/: the text package (POSTING.md, posting-sheet.csv, covers, captions, meta) is committed;
# the MP4s only ever live in the Release.
/posting/**/*.mp4
/episodes/*/render/
/video/out/
/video/build/
/scripts/fixtures/episodes/*/render/
/scripts/fixtures/episodes/*/cover.png
/scripts/fixtures/episodes/*/qa/

# Build output
/site/_site/

# Local noise
.DS_Store
__pycache__/
*.pyc
.env

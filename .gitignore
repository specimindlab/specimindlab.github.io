# Dependencies
node_modules/

# Finished videos never enter git history: GitHub Releases hold them.
*.zip
# posting/<batch>/: the text package (POSTING.md, posting-sheet.csv, covers, captions, meta) is committed;
# the MP4s only ever live in the Release.
/posting/**/*.mp4
/episodes/*/render/
# review stills: looked at, never committed (qa/report.md + qa/contact-sheet.jpg are)
/episodes/*/qa/stills/
# composed per episode by scripts/make_music.py (in render.yml and render_previews.sh)
/episodes/*/music.wav
/video/out/
/video/build/
/scripts/fixtures/episodes/*/render/
# review stills: looked at, never committed (qa/report.md + qa/contact-sheet.jpg are)
/episodes/*/qa/stills/
# composed per episode by scripts/make_music.py (in render.yml and render_previews.sh)
/episodes/*/music.wav
/scripts/fixtures/episodes/*/cover.png
/scripts/fixtures/episodes/*/qa/

# Build output
/site/_site/

# Local noise
.DS_Store
__pycache__/
*.pyc
.env
